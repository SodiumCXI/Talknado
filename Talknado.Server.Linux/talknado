#!/bin/bash

SERVICE="talknado"
BINARY_PATH="/usr/local/bin/talknado-server-bin"
CONFIG_DIR="/etc/talknado"
CONFIG_FILE="$CONFIG_DIR/talknado.conf"
SOCKET_FILE="/run/talknado/control.sock"
FIREWALL_STATE="$CONFIG_DIR/firewall"
INSTALL_URL="https://raw.githubusercontent.com/SodiumCXI/Talknado/main/Talknado.Server.Linux/install.sh"

QUALITIES="720p30, 1080p30, 1080p60"

require_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "Error: Root access required"
        exit 1
    fi
}

# Значения в файле — в одинарных кавычках: systemd берёт их буквально.
get_setting() {
    local value=""
    if [ -f "$CONFIG_FILE" ]; then
        value=$(sed -n "s/^$1=//p" "$CONFIG_FILE" | tail -n 1)
        value="${value#\'}"
        value="${value%\'}"
    fi
    echo "${value:-$2}"
}

save_setting() {
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
    local rest=""
    if [ -f "$CONFIG_FILE" ]; then
        rest=$(grep -v "^$1=" "$CONFIG_FILE")
    fi
    { [ -n "$rest" ] && echo "$rest"; echo "$1='$2'"; } > "$CONFIG_FILE.new"
    chmod 600 "$CONFIG_FILE.new"
    mv "$CONFIG_FILE.new" "$CONFIG_FILE"
}

is_running() {
    systemctl is-active --quiet "$SERVICE"
}

port_in_use() {
    command -v ss > /dev/null && [ -n "$(ss -Hlntu "sport = :$1")" ]
}

# Порт выбирается случайно один раз и дальше сам не меняется: ключ
# переживает перезапуск, а у разных серверов порты разные.
ensure_port() {
    [ -n "$(get_setting TALKNADO_PORT)" ] && return 0
    local port
    for i in $(seq 20); do
        port=$(shuf -i 49152-65535 -n 1)
        port_in_use "$port" || break
    done
    save_setting TALKNADO_PORT "$port"
}

active_firewall() {
    if command -v ufw > /dev/null && ufw status 2>/dev/null | grep -q "^Status: active"; then
        echo ufw
    elif command -v firewall-cmd > /dev/null && firewall-cmd --state > /dev/null 2>&1; then
        echo firewalld
    fi
}

# Открывается только то, что ещё закрыто, и закрывается только открытое здесь:
# чужие правила на этом же порту не трогаются. Что открыто — в FIREWALL_STATE.
# firewalld получает правила до перезагрузки: после неё их снова откроет служба.
firewall_open() {
    firewall_close
    local port tool opened="" p
    port=$(get_setting TALKNADO_PORT 0)
    tool=$(active_firewall)
    if [ "$port" = "0" ] || [ -z "$tool" ]; then
        return 0
    fi

    for p in tcp udp; do
        case "$tool" in
            ufw)
                ufw show added | grep -qE "^ufw allow $port(/$p)?( |$)" && continue
                ufw allow "$port/$p" comment Talknado > /dev/null || continue
                ;;
            firewalld)
                firewall-cmd --query-port="$port/$p" > /dev/null && continue
                firewall-cmd --add-port="$port/$p" > /dev/null || continue
                ;;
        esac
        opened="$opened $p"
    done

    if [ -n "$opened" ]; then
        echo "$tool $port$opened" > "$FIREWALL_STATE"
        echo "Opened port $port (${opened# }) in $tool"
    fi
    return 0
}

firewall_close() {
    [ -f "$FIREWALL_STATE" ] || return 0
    local tool port protocols p
    read -r tool port protocols < "$FIREWALL_STATE"
    for p in $protocols; do
        case "$tool" in
            ufw) ufw delete allow "$port/$p" > /dev/null ;;
            firewalld) firewall-cmd --remove-port="$port/$p" > /dev/null ;;
        esac
    done
    rm -f "$FIREWALL_STATE"
    echo "Closed port $port in $tool"
    return 0
}

print_port() {
    echo "Port: $(get_setting TALKNADO_PORT) (TCP and UDP)"
    print_firewall
}

print_firewall() {
    if [ -f "$FIREWALL_STATE" ]; then
        local tool
        read -r tool _ < "$FIREWALL_STATE"
        echo "Firewall: port opened in $tool"
    fi
}

# Порт держит запущенный сервер, поэтому проверка — только перед запуском
check_port_free() {
    local port
    port=$(get_setting TALKNADO_PORT)
    if ! is_running && port_in_use "$port"; then
        echo "Error: Port $port is already in use. Choose another with 'talknado port NUMBER'"
        return 1
    fi
    return 0
}

control() {
    "$BINARY_PATH" ctl "$SOCKET_FILE" "$@"
}

require_running() {
    if ! is_running; then
        echo "Server not running"
        return 1
    fi
    return 0
}

wait_for_key() {
    local key
    for i in $(seq 100); do
        if key=$(control key 2>/dev/null); then
            echo "Key: $key"
            print_port
            return 0
        fi
        sleep 0.1
    done

    echo "Error: Server failed to start"
    journalctl -u "$SERVICE" -n 20 --no-pager -o cat
    return 1
}

start_server() {
    if [ -z "$(get_setting TALKNADO_PASSWORD)" ]; then
        echo "Error: Password not set. Use 'talknado set-password'"
        return 1
    fi

    ensure_port
    if is_running; then
        echo "Server already running"
    else
        check_port_free || return 1
        systemctl reset-failed "$SERVICE" 2>/dev/null
        systemctl enable --now --quiet "$SERVICE" || return 1
        echo "Server started, it will also start after a reboot"
    fi
    wait_for_key
}

stop_server() {
    systemctl disable --now --quiet "$SERVICE"
    echo "Server stopped, it will not start after a reboot"
}

restart_server() {
    if [ -z "$(get_setting TALKNADO_PASSWORD)" ]; then
        echo "Error: Password not set. Use 'talknado set-password'"
        return 1
    fi

    ensure_port
    check_port_free || return 1
    systemctl reset-failed "$SERVICE" 2>/dev/null
    systemctl enable --quiet "$SERVICE"
    systemctl restart "$SERVICE" || return 1
    echo "Server restarted"
    wait_for_key
}

set_password() {
    if [ -z "$1" ]; then
        echo "Usage: talknado set-password 'password'"
        return 1
    fi

    PASSWORD="$1"

    if echo "$PASSWORD" | grep -q "[[:space:]']"; then
        echo "Error: Password cannot contain spaces or single quotes"
        return 1
    fi

    if [ ${#PASSWORD} -gt 40 ]; then
        echo "Error: Password cannot exceed 40 characters"
        return 1
    fi

    save_setting TALKNADO_PASSWORD "$PASSWORD"
    echo "Password set"

    if is_running; then
        echo "To apply changes, run: talknado restart"
    fi

    return 0
}

print_settings() {
    if [ -n "$(get_setting TALKNADO_PORT)" ]; then
        echo "Port: $(get_setting TALKNADO_PORT) (TCP and UDP)"
    fi
    echo "Max screen share quality: $(get_setting TALKNADO_QUALITY 1080p60)"
    BANDWIDTH=$(get_setting TALKNADO_BANDWIDTH 0)
    if [ "$BANDWIDTH" = "0" ]; then
        echo "File bandwidth: unlimited"
    else
        echo "File bandwidth: $BANDWIDTH Mbit/s"
    fi
}

show_status() {
    if is_running; then
        echo "Running since $(systemctl show -p ActiveEnterTimestamp --value "$SERVICE")"
        show_key
        control status
        print_firewall
    elif systemctl is-failed --quiet "$SERVICE"; then
        echo "Failed, see 'talknado logs'"
        print_settings
    else
        echo "Stopped"
        print_settings
    fi

    if systemctl is-enabled --quiet "$SERVICE" 2>/dev/null; then
        echo "Autostart: on"
    else
        echo "Autostart: off"
    fi
}

show_key() {
    require_running || return 1
    local key
    key=$(control key) || return 1
    echo "Key: $key"
}

show_users() {
    require_running || return 1
    control users
}

kick_user() {
    if [ -z "$1" ]; then
        echo "Usage: talknado kick ID (see 'talknado users')"
        return 1
    fi
    require_running || return 1
    control kick "$1"
}

# Без значения — показать текущее. Значение сохраняется и применяется сразу,
# если сервер запущен, иначе — при следующем запуске.
set_quality() {
    if [ -z "$1" ]; then
        if is_running; then
            control max-quality
        else
            echo "Max screen share quality: $(get_setting TALKNADO_QUALITY 1080p60)"
        fi
        return $?
    fi

    case "$1" in
        720p30|1080p30|1080p60) ;;
        *)
            echo "Error: Max quality must be one of: $QUALITIES"
            return 1
            ;;
    esac

    if is_running; then
        control max-quality "$1" || return 1
    else
        echo "Max screen share quality: $1 (applies on start)"
    fi
    save_setting TALKNADO_QUALITY "$1"
}

set_bandwidth() {
    if [ -z "$1" ]; then
        if is_running; then
            control bandwidth
        else
            echo "File bandwidth: $(get_setting TALKNADO_BANDWIDTH 0) Mbit/s (0 = unlimited)"
        fi
        return $?
    fi

    if ! [[ "$1" =~ ^[0-9]+$ ]]; then
        echo "Error: Bandwidth must be a whole number of Mbit/s, 0 = unlimited"
        return 1
    fi

    if is_running; then
        control bandwidth "$1" || return 1
    else
        echo "File bandwidth: $1 Mbit/s (applies on start)"
    fi
    save_setting TALKNADO_BANDWIDTH "$1"
}

set_port() {
    if [ -z "$1" ]; then
        ensure_port
        print_port
        return 0
    fi

    if ! [[ "$1" =~ ^[0-9]{1,5}$ ]] || [ "$1" -lt 1024 ] || [ "$1" -gt 65535 ]; then
        echo "Error: Port must be a number from 1024 to 65535"
        return 1
    fi

    local port=$((10#$1))
    if [ "$port" != "$(get_setting TALKNADO_PORT)" ] && port_in_use "$port"; then
        echo "Error: Port $port is already in use"
        return 1
    fi

    save_setting TALKNADO_PORT "$port"
    echo "Port: $port (TCP and UDP)"
    if is_running; then
        echo "To apply changes, run: talknado restart"
    fi
}

show_logs() {
    if [ "$1" = "-f" ]; then
        journalctl -u "$SERVICE" -f -o short-iso
    else
        journalctl -u "$SERVICE" -n 100 --no-pager -o short-iso
    fi
}

# install.sh заменяет этот файл, выполнение продолжается из уже открытой копии.
update_server() {
    curl -fsSL "$INSTALL_URL" | bash -s -- "$@"
}

show_version() {
    "$BINARY_PATH" version
}

uninstall() {
    echo "Uninstalling Talknado Server..."
    systemctl disable --now --quiet "$SERVICE" 2>/dev/null
    rm -f "/etc/systemd/system/$SERVICE.service"
    systemctl daemon-reload
    rm -rf "$CONFIG_DIR"
    echo "Removed the service and settings"

    # Каталоги данных версий до 1.2.1
    rm -rf /root/.talknado /home/*/.talknado

    rm -f /usr/local/bin/talknado "$BINARY_PATH"
    echo "Removed binaries"
    echo "Uninstall complete!"
}

show_help() {
    cat << EOF
Usage: talknado <command> [options]
Commands:
  start               Start the server and turn on autostart after a reboot
  stop                Stop the server and turn off autostart
  restart             Restart the server
  status              Show server status and session settings
  key                 Show connection key
  set-password 'pwd'  Set server password
  port [NUMBER]       Show or set the server port, TCP and UDP: 1024-65535
  users               List connected users with ID, ping and address
  kick ID             Kick a user and ban their address until restart
  max-quality [VALUE] Show or set the maximum screen share quality: $QUALITIES
  bandwidth [MBIT]    Show or set the file transfer limit in Mbit/s, 0 = unlimited
  logs [-f]           Show the server log, -f to follow it
  update [vX.X.X]     Update to the latest or the given server version
  version             Show version information
  uninstall           Uninstall Talknado Server
  help                Show this help
Max quality and bandwidth are saved and apply right away if the server is running.
A new port applies on restart. If ufw or firewalld is on, the port is opened
while the server runs and closed when it stops.
EOF
}

case "$1" in
    help|--help|-h|"")
        show_help
        [ -n "$1" ]
        exit $?
        ;;
    version|--version|-v)
        show_version
        exit $?
        ;;
esac

require_root

case "$1" in
    start) start_server ;;
    stop) stop_server ;;
    restart) restart_server ;;
    set-password) set_password "$2" ;;
    port) set_port "$2" ;;
    status) show_status ;;
    key) show_key ;;
    users) show_users ;;
    kick) kick_user "$2" ;;
    max-quality) set_quality "$2" ;;
    bandwidth) set_bandwidth "$2" ;;
    logs) show_logs "$2" ;;
    update) update_server "$2" ;;
    uninstall) uninstall ;;
    # Зовёт служба при запуске и остановке
    firewall-open) firewall_open ;;
    firewall-close) firewall_close ;;
    *)
        show_help
        exit 1
        ;;
esac

exit $?
