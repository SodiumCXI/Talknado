#!/bin/bash

# Управление сервером Talknado. Сервер — служба systemd talknado: systemd сам
# знает, жив ли процесс, поднимает его после перезагрузки и падения и ведёт
# журнал. Своих файлов с номером процесса у скрипта нет.

SERVICE="talknado"
BINARY_PATH="/usr/local/bin/talknado-server-bin"
CONFIG_DIR="/etc/talknado"
CONFIG_FILE="$CONFIG_DIR/talknado.conf"
SOCKET_FILE="/run/talknado/control.sock"
INSTALL_URL="https://raw.githubusercontent.com/SodiumCXI/Talknado/main/Talknado.Server.Linux/install.sh"

QUALITIES="720p30, 1080p30, 1080p60"

require_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "Error: Root access required"
        exit 1
    fi
}

# Значения в файле — в одинарных кавычках: systemd берёт их буквально.
get_setting() {
    local value=""
    if [ -f "$CONFIG_FILE" ]; then
        value=$(sed -n "s/^$1=//p" "$CONFIG_FILE" | tail -n 1)
        value="${value#\'}"
        value="${value%\'}"
    fi
    echo "${value:-$2}"
}

save_setting() {
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
    local rest=""
    if [ -f "$CONFIG_FILE" ]; then
        rest=$(grep -v "^$1=" "$CONFIG_FILE")
    fi
    { [ -n "$rest" ] && echo "$rest"; echo "$1='$2'"; } > "$CONFIG_FILE.new"
    chmod 600 "$CONFIG_FILE.new"
    mv "$CONFIG_FILE.new" "$CONFIG_FILE"
}

is_running() {
    systemctl is-active --quiet "$SERVICE"
}

control() {
    "$BINARY_PATH" ctl "$SOCKET_FILE" "$@"
}

require_running() {
    if ! is_running; then
        echo "Server not running"
        return 1
    fi
    return 0
}

# Ключ отдаёт работающий сервер, поэтому он всегда от текущего запуска.
wait_for_key() {
    local key
    for i in $(seq 100); do
        if key=$(control key 2>/dev/null); then
            echo "Key: $key"
            return 0
        fi
        sleep 0.1
    done

    echo "Error: Server failed to start"
    journalctl -u "$SERVICE" -n 20 --no-pager -o cat
    return 1
}

start_server() {
    if [ -z "$(get_setting TALKNADO_PASSWORD)" ]; then
        echo "Error: Password not set. Use 'talknado set-password'"
        return 1
    fi

    if is_running; then
        echo "Server already running"
    else
        systemctl enable --now --quiet "$SERVICE" || return 1
        echo "Server started, it will also start after a reboot"
    fi
    wait_for_key
}

stop_server() {
    systemctl disable --now --quiet "$SERVICE"
    echo "Server stopped, it will not start after a reboot"
}

restart_server() {
    if [ -z "$(get_setting TALKNADO_PASSWORD)" ]; then
        echo "Error: Password not set. Use 'talknado set-password'"
        return 1
    fi

    systemctl enable --quiet "$SERVICE"
    systemctl restart "$SERVICE" || return 1
    echo "Server restarted"
    wait_for_key
}

set_password() {
    if [ -z "$1" ]; then
        echo "Usage: talknado set-password 'password'"
        return 1
    fi

    PASSWORD="$1"

    if echo "$PASSWORD" | grep -q "[[:space:]']"; then
        echo "Error: Password cannot contain spaces or single quotes"
        return 1
    fi

    if [ ${#PASSWORD} -gt 40 ]; then
        echo "Error: Password cannot exceed 40 characters"
        return 1
    fi

    save_setting TALKNADO_PASSWORD "$PASSWORD"
    echo "Password set"

    if is_running; then
        echo "To apply changes, run: talknado restart"
    fi

    return 0
}

print_settings() {
    echo "Screen share quality: $(get_setting TALKNADO_QUALITY 720p30)"
    BANDWIDTH=$(get_setting TALKNADO_BANDWIDTH 0)
    if [ "$BANDWIDTH" = "0" ]; then
        echo "File bandwidth: unlimited"
    else
        echo "File bandwidth: $BANDWIDTH Mbit/s"
    fi
}

show_status() {
    if is_running; then
        echo "Running since $(systemctl show -p ActiveEnterTimestamp --value "$SERVICE")"
        show_key
        control status
    elif systemctl is-failed --quiet "$SERVICE"; then
        echo "Failed, see 'talknado logs'"
        print_settings
    else
        echo "Stopped"
        print_settings
    fi

    if systemctl is-enabled --quiet "$SERVICE" 2>/dev/null; then
        echo "Autostart: on"
    else
        echo "Autostart: off"
    fi
}

show_key() {
    require_running || return 1
    local key
    key=$(control key) || return 1
    echo "Key: $key"
}

show_users() {
    require_running || return 1
    control users
}

kick_user() {
    if [ -z "$1" ]; then
        echo "Usage: talknado kick ID (see 'talknado users')"
        return 1
    fi
    require_running || return 1
    control kick "$1"
}

# Без значения — показать текущее. Значение сохраняется и применяется сразу,
# если сервер запущен, иначе — при следующем запуске.
set_quality() {
    if [ -z "$1" ]; then
        if is_running; then
            control quality
        else
            echo "Screen share quality: $(get_setting TALKNADO_QUALITY 720p30)"
        fi
        return $?
    fi

    case "$1" in
        720p30|1080p30|1080p60) ;;
        *)
            echo "Error: Quality must be one of: $QUALITIES"
            return 1
            ;;
    esac

    if is_running; then
        control quality "$1" || return 1
    else
        echo "Screen share quality: $1 (applies on start)"
    fi
    save_setting TALKNADO_QUALITY "$1"
}

set_bandwidth() {
    if [ -z "$1" ]; then
        if is_running; then
            control bandwidth
        else
            echo "File bandwidth: $(get_setting TALKNADO_BANDWIDTH 0) Mbit/s (0 = unlimited)"
        fi
        return $?
    fi

    if ! [[ "$1" =~ ^[0-9]+$ ]]; then
        echo "Error: Bandwidth must be a whole number of Mbit/s, 0 = unlimited"
        return 1
    fi

    if is_running; then
        control bandwidth "$1" || return 1
    else
        echo "File bandwidth: $1 Mbit/s (applies on start)"
    fi
    save_setting TALKNADO_BANDWIDTH "$1"
}

show_logs() {
    if [ "$1" = "-f" ]; then
        journalctl -u "$SERVICE" -f -o short-iso
    else
        journalctl -u "$SERVICE" -n 100 --no-pager -o short-iso
    fi
}

# Установщик ставит новые файлы на место прежних и перезапускает работающий
# сервер; этот скрипт выполняется дальше из старой копии, она уже открыта.
update_server() {
    curl -fsSL "$INSTALL_URL" | bash -s -- "$@"
}

show_version() {
    "$BINARY_PATH" version
}

uninstall() {
    echo "Uninstalling Talknado Server..."
    systemctl disable --now --quiet "$SERVICE" 2>/dev/null
    rm -f "/etc/systemd/system/$SERVICE.service"
    systemctl daemon-reload
    rm -rf "$CONFIG_DIR"
    echo "Removed the service and settings"

    # Каталоги данных версий до 1.2.1
    rm -rf /root/.talknado /home/*/.talknado

    rm -f /usr/local/bin/talknado "$BINARY_PATH"
    echo "Removed binaries"
    echo "Uninstall complete!"
}

show_help() {
    cat << EOF
Usage: talknado <command> [options]
Commands:
  start              Start the server and turn on autostart after a reboot
  stop               Stop the server and turn off autostart
  restart            Restart the server
  status             Show server status and session settings
  key                Show connection key
  set-password 'pwd' Set server password
  users              List connected users with ID, ping and address
  kick ID            Kick a user and ban their address until restart
  quality [VALUE]    Show or set the screen share quality cap: $QUALITIES
  bandwidth [MBIT]   Show or set the file transfer limit in Mbit/s, 0 = unlimited
  logs [-f]          Show the server log, -f to follow it
  update [vX.X.X]    Update to the latest or the given server version
  version            Show version information
  uninstall          Uninstall Talknado Server
  help               Show this help
Quality and bandwidth are saved and apply right away if the server is running.
EOF
}

case "$1" in
    help|--help|-h|"")
        show_help
        [ -n "$1" ]
        exit $?
        ;;
    version|--version|-v)
        show_version
        exit $?
        ;;
esac

require_root

case "$1" in
    start) start_server ;;
    stop) stop_server ;;
    restart) restart_server ;;
    set-password) set_password "$2" ;;
    status) show_status ;;
    key) show_key ;;
    users) show_users ;;
    kick) kick_user "$2" ;;
    quality) set_quality "$2" ;;
    bandwidth) set_bandwidth "$2" ;;
    logs) show_logs "$2" ;;
    update) update_server "$2" ;;
    uninstall) uninstall ;;
    *)
        show_help
        exit 1
        ;;
esac

exit $?
