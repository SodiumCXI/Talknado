# Файл настроек читает systemd до понижения прав, поэтому он доступен только root.

[Unit]
Description=Talknado Server
Documentation=https://github.com/SodiumCXI/Talknado
# Внешний адрес для ключа узнаётся при запуске по сети
Wants=network-online.target
After=network-online.target
# Занятый порт не освободится сам: после пяти попыток служба останавливается
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
Environment=TALKNADO_QUALITY=1080p60 TALKNADO_BANDWIDTH=0 TALKNADO_PORT=0
EnvironmentFile=/etc/talknado/talknado.conf
# «+» — от root и без ограничений ниже: брандмауэр правит только root
ExecStartPre=+/usr/local/bin/talknado firewall-open
ExecStart=/usr/local/bin/talknado-server-bin serve --port ${TALKNADO_PORT} --control /run/talknado/control.sock --max-quality ${TALKNADO_QUALITY} --bandwidth ${TALKNADO_BANDWIDTH}
ExecStopPost=+/usr/local/bin/talknado firewall-close
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

DynamicUser=yes
RuntimeDirectory=talknado
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
