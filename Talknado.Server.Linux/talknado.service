# Файл настроек читает systemd до понижения прав, поэтому он доступен только root.

[Unit]
Description=Talknado Server
Documentation=https://github.com/SodiumCXI/Talknado
# Внешний адрес для ключа узнаётся при запуске по сети
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
Environment=TALKNADO_QUALITY=720p30 TALKNADO_BANDWIDTH=0
EnvironmentFile=/etc/talknado/talknado.conf
ExecStart=/usr/local/bin/talknado-server-bin serve --control /run/talknado/control.sock --quality ${TALKNADO_QUALITY} --bandwidth ${TALKNADO_BANDWIDTH}
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

DynamicUser=yes
RuntimeDirectory=talknado
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
