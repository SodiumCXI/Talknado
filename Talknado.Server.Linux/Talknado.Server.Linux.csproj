<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>talknado-server-bin</AssemblyName>
    <Authors>SodiumCXI</Authors>
  </PropertyGroup>

  <!-- Выпуск: dotnet publish -c Release -r linux-x64 — один самодостаточный файл -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Talknado.Server\Talknado.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="talknado;install.sh;README.md" />
  </ItemGroup>

  <!--
    Файл для релиза: talknado-server-<версия сервера>-linux-x64.tar.gz рядом с
    каталогом publish. Версия в имени — из Talknado.Server.csproj: по ней
    install.sh находит нужный сервер среди релизов клиента.
    tar на Windows — системный: tar из Git принял бы «D:» за удалённый хост.
  -->
  <Target Name="PackServerRelease" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <XmlPeek XmlInputPath="..\Talknado.Server\Talknado.Server.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="ServerVersion" />
    </XmlPeek>
    <PropertyGroup>
      <PublishFullDir>$([System.IO.Path]::GetFullPath('$(PublishDir)').TrimEnd('\').TrimEnd('/'))</PublishFullDir>
      <ServerPackage>$([System.IO.Path]::GetDirectoryName('$(PublishFullDir)'))\talknado-server-$(ServerVersion)-linux-x64.tar.gz</ServerPackage>
      <TarTool Condition="'$(OS)' == 'Windows_NT'">"$(SystemRoot)\System32\tar.exe"</TarTool>
      <TarTool Condition="'$(OS)' != 'Windows_NT'">tar</TarTool>
    </PropertyGroup>
    <Copy SourceFiles="talknado" DestinationFolder="$(PublishFullDir)" />
    <Exec Command="$(TarTool) -czf &quot;$(ServerPackage)&quot; -C &quot;$(PublishFullDir)&quot; talknado-server-bin talknado" />
    <Message Importance="high" Text="Server release: $(ServerPackage)" />
  </Target>

</Project>
