<?xml version="1.0" encoding="utf-8"?>
<!--
  Сборка для релиза: самодостаточная win-x64 в один файл, без сжатия и без
  ReadyToRun. Родные библиотеки WPF и файлы из lib/ лежат рядом с exe.
  dotnet publish Talknado.Client -p:PublishProfile=win-x64-portable
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\Talknado\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>

  <!-- В папку релиза — лицензия; символы библиотеки сервера и .lib-заглушки
       ONNX Runtime для компоновки программе не нужны -->
  <Target Name="TidyReleaseFolder" AfterTargets="Publish">
    <ItemGroup>
      <ReleaseClutter Include="$(PublishDir)*.pdb;$(PublishDir)*.lib" />
    </ItemGroup>
    <Delete Files="@(ReleaseClutter)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\LICENSE" DestinationFiles="$(PublishDir)LICENSE.txt" />
  </Target>
</Project>
