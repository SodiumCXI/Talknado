<local:TalknadoWindow x:Class="Talknado.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Talknado.Client.Properties.Localization"
        xmlns:local="clr-namespace:Talknado.Client.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Talknado.Client.Views.Controls"
        xmlns:triggers="clr-namespace:Talknado.Client.Views.Triggers"
        xmlns:cnv="clr-namespace:Talknado.Client.Views.Converters"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Style="{StaticResource MainWindowStyle}" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome 
            CaptionHeight="0" 
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <local:TalknadoWindow.Resources>
        <cnv:InputTextBoxMaxHeightConverter x:Key="InputTextBoxMaxHeightConverter"/>
    </local:TalknadoWindow.Resources>
    <Border x:Name="BorderAround"
            Style="{StaticResource BorderAround}">
        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  x:Name="TitleBar"
                  Background="{DynamicResource TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"/>
                <Button Grid.Column="1"
                        x:Name="MinimizeButton"
                        Style="{DynamicResource MinimizeButtonStyle}"
                        Click="MinimizeButton_Click"/>
                <Button Grid.Column="2"
                        x:Name="MaximizeButton"
                        Style="{DynamicResource MaximizeButtonStyle}"
                        Click="MaximizeButton_Click"/>
                <Button Grid.Column="3"
                        x:Name="CloseButton"
                        Style="{DynamicResource CloseButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
            <Grid Grid.Row="1"
                  Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="375"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{DynamicResource LeftPanelBackgroundBrush}">
                    <Border Background="{DynamicResource LeftPanelBackgroundBrush}"
                            Margin="0,0,1,0">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource BorderColor}"
                                              Direction="0" 
                                              ShadowDepth="1" 
                                              BlurRadius="1" 
                                              Opacity="0.5"/>
                        </Border.Effect>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                                <Button Content="{x:Static l:Strings.DisconnectButton}"
                                        Style="{DynamicResource TopPanelButtonStyle}"
                                        Command="{Binding SoftRebootCommand}"/>
                                <Button Content="{x:Static l:Strings.SettingsButton}" 
                                        Style="{DynamicResource TopPanelButtonStyle}"
                                        Command="{Binding ViewSettingsCommand}"/>
                                <Button Content="{x:Static l:Strings.AboutButton}" 
                                        Style="{DynamicResource TopPanelButtonStyle}"
                                        Command="{Binding OpenLinkCommand}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Bottom"
                                    Background="{DynamicResource TitleBarBrush}"
                                    CornerRadius="8,8,0,0"
                                    Height="29">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{DynamicResource PrimaryTextStyle}"
                                               FontWeight="Bold"
                                               Margin="9,0,0,0"
                                               Text="{x:Static l:Strings.KeyLabel}" 
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Style="{DynamicResource SelectableTextStyle}"
                                             MaxWidth="250"
                                             TextWrapping="NoWrap"
                                             Background="Transparent"
                                             Text="{Binding ConnectionInfo.FormattedConnectionKey}" 
                                             VerticalAlignment="Center"
                                             Margin="2,0,0,0"
                                             PreviewMouseDown="TextBox_MouseDown"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Cursor="Hand"/>
                                    <StackPanel Grid.Column="2"/>
                                    <Grid Grid.Column="3">
                                        <Border Style="{StaticResource ScreenShareButtonBackground}"/>
                                        <Button Style="{DynamicResource ControlPanelButton}"
                                                Command="{Binding ViewMonitorSelectionCommand}"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center" Cursor="Hand">
                                            <svgc:SvgViewbox Source="/Resources/screen_share_white.svg" Width="22" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Column="4">
                                        <Border Style="{StaticResource MicrophoneButtonBackground}"/>
                                        <Button Style="{DynamicResource ControlPanelButton}"
                                                Command="{Binding ToggleMicrophoneCommand}"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                            <svgc:SvgViewbox Width="24" VerticalAlignment="Center">
                                                <svgc:SvgViewbox.Style>
                                                    <Style TargetType="svgc:SvgViewbox">
                                                        <Setter Property="Source" Value="/Resources/mic_off_white.svg"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AudioManager.IsMicrophoneActive}" Value="True">
                                                                <Setter Property="Source" Value="/Resources/mic_on_white.svg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </svgc:SvgViewbox.Style>
                                            </svgc:SvgViewbox>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                            <controls:UserListControl/>
                        </DockPanel>
                    </Border>
                </Border>
                <Border Grid.Column="1"
                        Background="{DynamicResource RightPanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource RightPanelBackgroundBrush}">
                            <controls:MessageListControl/>
                        </Border>
                        <Border Grid.Row="1"
                                Background="{DynamicResource TextBoxBrush}"
                                CornerRadius="8,8,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource BorderColor}"
                                                  Direction="90"
                                                  ShadowDepth="1"
                                                  BlurRadius="2"
                                                  Opacity="1"/>
                            </Border.Effect>
                            <TextBox x:Name="InputTextBox"
                                     Style="{DynamicResource InputTextBoxStyle}"
                                     Text="{Binding InputTextBoxValue, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="InputTextBox_TextChanged"
                                     SizeChanged="InputTextBox_SizeChanged">
                                <TextBox.MaxHeight>
                                    <MultiBinding Converter="{StaticResource InputTextBoxMaxHeightConverter}">
                                        <Binding ElementName="MainWindowName" Path="ActualHeight"/>
                                        <Binding ElementName="TitleBar" Path="ActualHeight"/>
                                    </MultiBinding>
                                </TextBox.MaxHeight>
                                <i:Interaction.Triggers>
                                    <triggers:EnterKeyTrigger>
                                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                                            MethodName="AnimateInputMessage"/>
                                        <i:InvokeCommandAction Command="{Binding SendMessageCommand}"/>
                                    </triggers:EnterKeyTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Canvas x:Name="AnimationCanvas" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</local:TalknadoWindow>