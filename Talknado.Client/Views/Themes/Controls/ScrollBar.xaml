<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cnv="clr-namespace:Talknado.Client.Views.Converters">

    <cnv:ScrollThumbViewportConverter x:Key="ScrollThumbViewportConverter"/>

    <!--
        Системная полоса прокрутки светлая и на тёмном фоне выглядит чужой.
        Стрелок нет: они занимают место и в списке сообщений не нужны.
    -->

    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!--
                        Радиус задан числом, а не «таблеткой» 999: WPF не сводит
                        большой радиус к половине ширины и растягивает бегунок
                        в овал. Ширина бегунка — системная ширина полосы (17)
                        без отступов по бокам.
                    -->
                    <!--
                        Цвета ползунка приходят от самой полосы: Foreground —
                        покой, BorderBrush — наведение. Так один шаблон
                        обслуживает и ленту на тёмном фоне, и поле ввода
                        на приподнятой поверхности.
                    -->
                    <Border x:Name="Bd"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                            CornerRadius="{DynamicResource RadiusScrollThumb}"
                            Margin="1,0"
                            SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ScrollBar}}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollThumbHoverBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <!--
                            Видимая часть подаётся через конвертер: он не даёт
                            бегунку стать короче предела. MinHeight у бегунка
                            на расчёт Track не влияет.
                        -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.ViewportSize>
                                <MultiBinding Converter="{StaticResource ScrollThumbViewportConverter}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ViewportSize"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualHeight"/>
                                </MultiBinding>
                            </Track.ViewportSize>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                              Command="{x:Static ScrollBar.PageUpCommand}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                              Command="{x:Static ScrollBar.PageDownCommand}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="10"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Неявный стиль, как у всплывающей подсказки: полоса прокрутки обязана
        выглядеть одинаково в лентах, в списках и в поле ввода, а расстановка
        по ключу в каждом месте даёт пропуски.
    -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarStyle}"/>

    <!-- Полоса внутри поля ввода: своя пара тонов, светлее поверхности поля -->
    <Style x:Key="InputScrollBarStyle" TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarStyle}">
        <Setter Property="Foreground" Value="{DynamicResource InputScrollThumbBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputScrollThumbHoverBrush}"/>
    </Style>

</ResourceDictionary>
