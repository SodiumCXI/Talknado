<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        ВСЕ РАЗМЕРЫ И ОТСТУПЫ ПРИЛОЖЕНИЯ ЛЕЖАТ ЗДЕСЬ.
        В разметке окон чисел нет: поменял значение тут — изменилось везде.

        Что подвинуть — какой ключ править:

        расстояние между значками в ряду ......... GapInline
        расстояние между строками участников ..... GapRow
        поля внутри строки участника ............. PadRow
        поля вокруг списка участников ............ PadFeed
        поля вокруг ленты сообщений .............. PadFeed
        поля внутри карточки сообщения ........... PadCard
        поля вокруг строки ввода и ряда кнопок ... PadBottomHost
        поля внутри кнопок и полей ввода ......... PadControl
        высота строки участника .................. RowHeight
        высота кнопок и полей ввода .............. ControlHeight
        размер значка ............................ IconSize
        размер аватара ........................... AvatarSize
        размер превью монитора ................... MonitorPreviewHeight
        расстояние между плитками мониторов ...... GapTile
        скругление ............................... RadiusCard / RadiusControl
        полоса заголовка окна .................... TitleBar*
        кнопка воспроизведения на превью видео ... MediaBadgeSize
        значок файла в карточке сообщения ........ AttachmentIconBoxSize
        значок задержки в строке участника ....... StatusIconSize
        выключенный микрофон в строке участника .. MicOffIconSize
        поля окна просмотра картинок и видео ..... PadViewer

        Связка, которую правят вместе: PadFeed, GapRow и GapRowTrim.
        Поля списка видны всегда, а промежуток между строками — только когда
        виден край содержимого, поэтому последний промежуток снимается
        отрицательным отступом панели (GapRowTrim = минус GapRow).
    -->

    <!-- ФОРМА -->
    <!-- скругление карточек сообщений и панелей -->
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <!-- скругление кнопок, полей ввода, строк участников -->
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <!--
        Тонкие дорожки высотой 4: ползунок и полоса загрузки. Радиус ровно в половину
        высоты: больший WPF не обрезает, а растягивает в эллипс по всей длине.
    -->
    <CornerRadius x:Key="RadiusTrack">2</CornerRadius>
    <!-- бегунок полос прокрутки в ленте, списках и поле ввода -->
    <CornerRadius x:Key="RadiusScrollThumb">6</CornerRadius>

    <!-- ВЫСОТЫ -->
    <!-- строка участника в левом списке -->
    <sys:Double x:Key="RowHeight">44</sys:Double>
    <!-- кнопки, поля ввода, выпадающие списки — все одной высоты -->
    <sys:Double x:Key="ControlHeight">34</sys:Double>

    <!-- ЗНАЧКИ -->
    <!-- размер любого значка в кнопке или строке -->
    <sys:Double x:Key="IconSize">22</sys:Double>
    <!--
        Значок, рисунок которого занимает всю рамку целиком: диагональные
        стрелки «раскрыть» при общем размере выглядят крупнее соседей.
    -->
    <sys:Double x:Key="IconSizeCompact">20</sys:Double>
    <!-- значок задержки в строке участника: стоит в строке текста, а не в кнопке -->
    <sys:Double x:Key="StatusIconSize">16</sys:Double>
    <!-- выключенный микрофон в строке участника: рисунок узкий, поэтому крупнее значка задержки -->
    <sys:Double x:Key="MicOffIconSize">20</sys:Double>
    <!-- ВЫБОР МОНИТОРА -->
    <!-- высота превью монитора; ширина берётся от его соотношения сторон -->
    <sys:Double x:Key="MonitorPreviewHeight">176</sys:Double>
    <!-- плашка с номером: квадрат, чтобы цифра не растягивала её по ширине -->
    <sys:Double x:Key="MonitorBadgeSize">56</sys:Double>

    <!-- ВЛОЖЕНИЯ -->
    <!-- круглая кнопка воспроизведения поверх превью видео -->
    <sys:Double x:Key="MediaBadgeSize">48</sys:Double>
    <!-- кнопка поверх превью: сохранить в «Загрузки» -->
    <sys:Double x:Key="MediaBadgeButtonSize">32</sys:Double>
    <!-- квадрат со значком файла в карточке сообщения; в строке ввода — ControlHeight, как крестик рядом -->
    <sys:Double x:Key="AttachmentIconBoxSize">40</sys:Double>
    <!-- значок внутри этого квадрата: крупнее обычного, файл — главное в карточке -->
    <sys:Double x:Key="FileGlyphSize">26</sys:Double>
    <!-- толщина полосы загрузки -->
    <sys:Double x:Key="ProgressBarHeight">4</sys:Double>
    <!-- ширина регулятора громкости в окне просмотра -->
    <sys:Double x:Key="ViewerVolumeWidth">120</sys:Double>

    <!-- ПАНЕЛЬ ХОСТА -->
    <!-- шесть строк участников: дальше список прокручивается, а окно не растёт -->
    <sys:Double x:Key="SessionListMaxHeight">264</sys:Double>

    <!-- ПРОКРУТКА -->
    <!-- бегунок не короче этого, иначе на длинной ленте он сжимается в точку -->
    <sys:Double x:Key="ScrollThumbMinLength">40</sys:Double>

    <!-- толщина линии значка; значки линейные, не залитые -->
    <sys:Double x:Key="IconStroke">1.6</sys:Double>

    <!-- АВАТАР УЧАСТНИКА -->
    <!-- кружок с инициалом -->
    <sys:Double x:Key="AvatarSize">28</sys:Double>

    <!-- ПОЛОСА ЗАГОЛОВКА ОКНА -->
    <sys:Double x:Key="TitleBarHeight">30</sys:Double>
    <!-- ширина кнопок свернуть/развернуть/закрыть -->
    <sys:Double x:Key="TitleBarButtonWidth">44</sys:Double>
    <!-- значки в них мельче обычных: полоса низкая -->
    <sys:Double x:Key="TitleBarIconSize">14</sys:Double>

    <!--
        ПОЛЯ (Padding) — расстояние от края блока до его содержимого.
        Порядок чисел в Thickness: слева, сверху, справа, снизу.
        Одно число — одинаково со всех сторон.
    -->
    <!-- внутри карточки сообщения и всплывающей подсказки -->
    <Thickness x:Key="PadCard">12</Thickness>
    <!-- внутри кнопок с текстом, полей ввода, выпадающих списков -->
    <Thickness x:Key="PadControl">12,0</Thickness>
    <!--
        Внутри строки участника: слева до аватара, справа до кнопки динамика.
        Справа пять — столько же, сколько у кнопки остаётся сверху и снизу
        (высота строки 44 минус высота кнопки 34, пополам).
    -->
    <Thickness x:Key="PadRow">10,0,5,0</Thickness>
    <!-- строка участника в панели хоста: без аватара ник встаёт вровень с текстом полей над списком -->
    <Thickness x:Key="PadSessionRow">14,0,5,0</Thickness>
    <!--
        Вокруг списка участников и ленты сообщений. Одинаково со всех сторон
        и в любом положении прокрутки: поля списка не прокручиваются вместе
        с содержимым, в отличие от промежутка между строками.
    -->
    <Thickness x:Key="PadFeed">12</Thickness>
    <!--
        Блок, прижатый к низу панели: строка ввода и ряд кнопок звонка.
        Сверху ноль — этот зазор уже дало поле списка над ним, иначе
        они складываются и снизу выходит вдвое больше, чем по бокам.
    -->
    <Thickness x:Key="PadBottomHost">12,0,12,12</Thickness>
    <!--
        Подпись под вложением в карточке сообщения: отступ сверху от вложения,
        два пикселя влево — та же подгонка, что у MessageTextStyle.
    -->
    <Thickness x:Key="MessageCaptionMargin">-2,6,0,0</Thickness>
    <!-- поля окна просмотра вокруг картинки и видео -->
    <Thickness x:Key="PadViewer">24</Thickness>
    <!-- поля плашки длительности поверх превью видео -->
    <Thickness x:Key="PadBadge">6,2</Thickness>

    <!--
        ИНТЕРВАЛЫ (Margin) — расстояние между соседними элементами.
        Каждый элемент даёт отступ справа или снизу от себя, последний в ряду — нет.
    -->
    <!-- между значками и кнопками в одном ряду -->
    <Thickness x:Key="GapInline">0,0,8,0</Thickness>
    <!--
        Строка участника: ник, выключенный микрофон, число задержки, её
        значок. Значки нарисованы с полем внутри рамки, поэтому у микрофона
        отступы поджаты — зазоры на глаз те же 8, что от аватара до ника.
        Число задержки на пиксель ниже значка: у цифр нет нижних выносных,
        и по центру они кажутся приподнятыми.
    -->
    <Thickness x:Key="MicOffIconMargin">-2,0,5,0</Thickness>
    <Thickness x:Key="PingTextMargin">0,1,4,0</Thickness>
    <!-- между строками списка, карточками сообщений и внутри карточки -->
    <Thickness x:Key="GapRow">0,0,0,6</Thickness>
    <!-- отступ сверху между строками: там, где нижний дал бы лишнее у края -->
    <Thickness x:Key="GapRowTop">0,6,0,0</Thickness>
    <!--
        Снимает промежуток у последней строки списка: иначе в конце ленты
        нижнее поле выходит на GapRow больше, чем в остальных положениях.
        Всегда минус GapRow.
    -->
    <Thickness x:Key="GapRowTrim">0,0,0,-6</Thickness>
    <!--
        Кнопка действия внутри блока формы: снизу ничего не нужно, там уже
        поле самого блока. Сверху 20 — она отделена сильнее прочих блоков.
    -->
    <Thickness x:Key="GapActionInCard">0,20,0,4</Thickness>
    <!--
        Плитки мониторов: отступ со всех сторон, потому что плитки идут
        сеткой, а не рядом. Тем же ключом отступает и сама сетка — тогда
        и снаружи, и между плитками стыкуются два отступа, то есть 12,
        как поля в остальных окнах.
    -->
    <Thickness x:Key="GapTile">6</Thickness>
    <!-- отступ сверху между блоками: там, где нижний дал бы лишнее у края -->
    <Thickness x:Key="GapBlockTop">0,14,0,0</Thickness>
    <!-- между блоками формы -->
    <Thickness x:Key="GapBlock">0,0,0,14</Thickness>

    <!-- Толщина кольца фокуса клавиатуры. В 2 пикселя: однопиксельное
         на скруглении рисуется ступеньками. Других границ в теме нет. -->
    <Thickness x:Key="FocusBorderThickness">2</Thickness>

</ResourceDictionary>
