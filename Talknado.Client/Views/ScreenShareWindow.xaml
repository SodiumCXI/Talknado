<local:TalknadoWindow x:Class="Talknado.Client.Views.ScreenShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Talknado.Client.Views"
        xmlns:vm="clr-namespace:Talknado.Client.ViewModels"
        xmlns:cnv="clr-namespace:Talknado.Client.Views.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ScreenShareViewModel}"
        Style="{StaticResource AppWindowStyle}"
        Title="{Binding ScreenSharePlayer.ScreenShareUsername}"
        Width="800" Height="480"
        MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <local:TalknadoWindow.Resources>
        <cnv:FpsTextConverter x:Key="FpsTextConverter"/>
    </local:TalknadoWindow.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="TitleBar"
              Height="{DynamicResource TitleBarHeight}"
              Background="{DynamicResource ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="{DynamicResource PadControl}">
                <TextBlock Style="{DynamicResource BodyTextStyle}"
                           Text="{Binding ScreenSharePlayer.ScreenShareUsername}"
                           TextTrimming="CharacterEllipsis"
                           Margin="{DynamicResource GapInline}"/>
                <!-- Счётчик кадров приглушён: он состояние связи,
                     а не имя того, чей экран показан -->
                <TextBlock Style="{DynamicResource FpsTextStyle}"
                           Text="{Binding ScreenSharePlayer.FramesPerSecond, Converter={StaticResource FpsTextConverter}}"/>
            </StackPanel>

            <Slider Grid.Column="1"
                    Style="{DynamicResource CompactSliderStyle}"
                    Minimum="0" Maximum="100"
                    SmallChange="5" LargeChange="20"
                    Value="{Binding UsersInfo.ScreenShareVolume}"
                    Margin="{DynamicResource GapInline}"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <Button Grid.Column="2" x:Name="MaximizeButton"
                    Style="{DynamicResource TitleBarMaximizeButtonStyle}"
                    Click="MaximizeButton_Click">
                <Path Style="{DynamicResource TitleBarIconStyle}" Data="{StaticResource IconWindowMaximize}"/>
            </Button>

            <Button Grid.Column="3" x:Name="CloseButton"
                    Style="{DynamicResource TitleBarCloseButtonStyle}"
                    Click="CloseButton_Click">
                <Path Style="{DynamicResource TitleBarIconStyle}" Data="{StaticResource IconWindowClose}"/>
            </Button>
        </Grid>

        <!--
            Над картинкой нет ни эффекта, ни прозрачности, ни трансформации:
            каждое из них заставляет WPF пересобирать слой на каждом кадре,
            а кадров тридцать в секунду.
        -->
        <Image Grid.Row="1"
               Source="{Binding ScreenSharePlayer.DisplayImage}"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="LowQuality"/>
    </Grid>
</local:TalknadoWindow>
