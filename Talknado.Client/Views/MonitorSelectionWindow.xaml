<local:TalknadoWindow x:Class="Talknado.Client.Views.MonitorSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Talknado.Client.Properties.Localization"
        xmlns:local="clr-namespace:Talknado.Client.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource MonitorSelectionWindowStyle}" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome 
        CaptionHeight="0" 
        ResizeBorderThickness="6"
        CornerRadius="0"
        GlassFrameThickness="0"
        UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="BorderAround" Style="{StaticResource BorderAround}">
        <Grid Background="{DynamicResource SettingsBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  x:Name="TitleBar"
                  Background="{DynamicResource TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="{x:Static l:Strings.MonitorSelectionTitle}"
                           FontFamily="{StaticResource TitleBarFont}"
                           FontSize="{StaticResource SecondaryFontSize}"
                           FontWeight="DemiBold"
                           Foreground="{DynamicResource TitleBarTextBrush}"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
                           Margin="12,0,0,0"/>
                <Button Grid.Column="1"
                        x:Name="CloseButton"
                        Style="{DynamicResource CloseButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
            <Grid Grid.Row="1" Background="{DynamicResource SettingsBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding ScreenMonitorManager.Monitors}"
                              Margin="0,0,10,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ScreenMonitorManager.GridColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10,10,0,0"
                                    Cursor="Hand">
                                <Grid>
                                    <Image Source="{Binding Preview}"
                                           Stretch="Uniform">
                                        <Image.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Image.InputBindings>
                                    </Image>
                                    <Border Background="#88000000"
                                            CornerRadius="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <TextBlock Style="{StaticResource PrimaryTextStyle}"
                                                   Text="{Binding MonitorNumber}"
                                                   Width="35"
                                                   FontSize="32"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</local:TalknadoWindow>