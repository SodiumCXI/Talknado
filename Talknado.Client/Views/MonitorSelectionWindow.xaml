<local:TalknadoWindow x:Class="Talknado.Client.Views.MonitorSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:Talknado.Client.Properties.Localization"
        xmlns:local="clr-namespace:Talknado.Client.Views"
        xmlns:vm="clr-namespace:Talknado.Client.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MonitorSelectionViewModel}"
        Style="{StaticResource AppWindowStyle}"
        Title="{x:Static l:Strings.MonitorSelectionTitle}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!--
        Размер окна считает WPF: высота превью задана метрикой, ширину даёт
        соотношение сторон монитора.
    -->

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="TitleBar"
              Height="{DynamicResource TitleBarHeight}"
              Background="{DynamicResource ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{DynamicResource MutedTextStyle}"
                       Text="{x:Static l:Strings.MonitorSelectionTitle}"
                       Margin="{DynamicResource PadControl}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" x:Name="CloseButton"
                    Style="{DynamicResource TitleBarCloseButtonStyle}"
                    Click="CloseButton_Click">
                <Path Style="{DynamicResource TitleBarIconStyle}" Data="{StaticResource IconWindowClose}"/>
            </Button>
        </Grid>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding ScreenMonitorManager.Monitors}"
                      Margin="{DynamicResource GapTile}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding ScreenMonitorManager.GridColumns}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                        Щелчок принимает вся плитка, а не только картинка:
                        при разном соотношении сторон ячейка сетки шире
                        превью, и промах по краю выглядит как «не нажалось».
                    -->
                    <Grid x:Name="Tile"
                          Margin="{DynamicResource GapTile}"
                          Background="Transparent"
                          Cursor="Hand">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"/>
                        </Grid.InputBindings>

                        <!-- Скругление рамки не обрезает вложенную картинку,
                             поэтому превью — фон рамки. Невидимая Image только
                             задаёт размер по соотношению сторон монитора -->
                        <Border CornerRadius="{DynamicResource RadiusCard}"
                                SnapsToDevicePixels="True"
                                RenderOptions.BitmapScalingMode="LowQuality">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Preview}" Stretch="Fill"/>
                            </Border.Background>
                            <Image Source="{Binding Preview}"
                                   Height="{DynamicResource MonitorPreviewHeight}"
                                   Stretch="Uniform"
                                   Visibility="Hidden"/>
                        </Border>

                        <!-- Обводка наведения тем же приёмом, что кольцо «говорит»
                             у строки участника: отдельный слой поверх плитки,
                             иначе картинка съезжала бы внутрь при её появлении -->
                        <Border x:Name="HoverRing"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="{DynamicResource FocusBorderThickness}"
                                CornerRadius="{DynamicResource RadiusCard}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>

                        <Border Background="{DynamicResource MonitorBadgeBrush}"
                                CornerRadius="{DynamicResource RadiusCard}"
                                Width="{DynamicResource MonitorBadgeSize}"
                                Height="{DynamicResource MonitorBadgeSize}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <TextBlock Style="{DynamicResource MonitorNumberStyle}"
                                       Text="{Binding MonitorNumber}"/>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</local:TalknadoWindow>
