<local:TalknadoWindow x:Class="Talknado.Client.Views.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:Talknado.Client.Properties.Localization"
        xmlns:local="clr-namespace:Talknado.Client.Views"
        xmlns:vm="clr-namespace:Talknado.Client.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:cnv="clr-namespace:Talknado.Client.Views.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:StartWindowViewModel}"
        Style="{StaticResource AppWindowStyle}"
        Title="Talknado Connect"
        Width="320" MinWidth="320"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <local:TalknadoWindow.Resources>
        <cnv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <cnv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </local:TalknadoWindow.Resources>

    <!--
        Ритм отступов один на всё окно: подпись отделена от своего поля
        на GapRow, пара «подпись плюс поле» от следующей — на GapBlock.
        Поля и кнопка лежат в блоке формы: он задаёт им ширину и
        отделяет форму от фона окна. Сообщение об ошибке вынесено за него:
        оно общее для обоих режимов и внутри вкладок объявлялось бы дважды.
        Высоту окна считает WPF: на вкладке сервера полей больше.
    -->

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Полоса заголовка. Разворота нет: окно не тянется -->
        <Grid Grid.Row="0" x:Name="TitleBar"
              Height="{DynamicResource TitleBarHeight}"
              Background="{DynamicResource ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{DynamicResource MutedTextStyle}"
                       Text="{x:Static local:StartWindow.ApplicationTitle}"
                       Margin="{DynamicResource PadControl}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" x:Name="MinimizeButton"
                    Style="{DynamicResource TitleBarButtonBaseStyle}"
                    Click="MinimizeButton_Click">
                <Path Style="{DynamicResource TitleBarIconStyle}" Data="{StaticResource IconWindowMinimize}"/>
            </Button>

            <Button Grid.Column="2" x:Name="CloseButton"
                    Style="{DynamicResource TitleBarCloseButtonStyle}"
                    Click="CloseButton_Click">
                <Path Style="{DynamicResource TitleBarIconStyle}" Data="{StaticResource IconWindowClose}"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="{DynamicResource PadCard}">
            <TabControl Style="{DynamicResource TabControlStyle}"
                        PreviewMouseLeftButtonDown="ModeTabs_PreviewMouseLeftButtonDown">

                <TabItem Header="{x:Static l:Strings.ClientChoice}">
                    <Border Style="{DynamicResource FormBlockStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource MutedTextStyle}"
                                       Text="{x:Static l:Strings.NicknameLabel}"
                                       Margin="{DynamicResource GapRow}"/>
                            <TextBox Style="{DynamicResource InputStyle}"
                                     Text="{Binding UsernameTextBoxValue, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="{DynamicResource GapBlock}"
                                     GotKeyboardFocus="PrefilledInput_GotKeyboardFocus"
                                     MaxLength="20"/>

                            <TextBlock Style="{DynamicResource MutedTextStyle}"
                                       Text="{x:Static l:Strings.ConnectionKeyLabel}"
                                       Margin="{DynamicResource GapRow}"/>
                            <TextBox Style="{DynamicResource InputStyle}"
                                     Text="{Binding ConnectionKeyTextBoxValue, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"/>

                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="{DynamicResource GapActionInCard}"
                                    Command="{Binding ConnectWithoutServerCommand}"
                                    Cursor="Hand"
                                    IsEnabled="{Binding IsWaitingForConnection, Converter={StaticResource InverseBoolConverter}}">
                                <Grid>
                                    <TextBlock Text="{x:Static l:Strings.ConnectButton}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWaitingForConnection}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Path Style="{DynamicResource SpinnerStyle}"
                                          Visibility="{Binding IsWaitingForConnection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="{x:Static l:Strings.ServerChoice}"
                         IsSelected="{Binding IsServerTabSelected}">
                    <Border Style="{DynamicResource FormBlockStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource MutedTextStyle}"
                                       Text="{x:Static l:Strings.NicknameLabel}"
                                       Margin="{DynamicResource GapRow}"/>
                            <TextBox Style="{DynamicResource InputStyle}"
                                     Text="{Binding UsernameTextBoxValue, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="{DynamicResource GapBlock}"
                                     GotKeyboardFocus="PrefilledInput_GotKeyboardFocus"
                                     MaxLength="20"/>

                            <TextBlock Style="{DynamicResource MutedTextStyle}"
                                       Text="{x:Static l:Strings.PasswordLabel}"
                                       Margin="{DynamicResource GapRow}"/>
                            <TextBox Style="{DynamicResource InputStyle}"
                                     Text="{Binding PasswordTextBoxValue, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="{DynamicResource GapBlock}"
                                     MaxLength="40"/>

                            <CheckBox Style="{DynamicResource CheckBoxStyle}"
                                      Content="{x:Static l:Strings.EnableUpnpPortForwardingText}"
                                      IsChecked="{Binding IsUpnpEnabled}"
                                      Cursor="Hand"
                                      HorizontalAlignment="Center"/>

                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="{DynamicResource GapActionInCard}"
                                    Command="{Binding ConnectWithServerCommand}"
                                    Cursor="Hand"
                                    IsEnabled="{Binding IsWaitingForConnection, Converter={StaticResource InverseBoolConverter}}">
                                <Grid>
                                    <TextBlock Text="{x:Static l:Strings.HostButton}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWaitingForConnection}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Path Style="{DynamicResource SpinnerStyle}"
                                          Visibility="{Binding IsWaitingForConnection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <TextBlock Style="{DynamicResource ErrorTextStyle}"
                       Text="{Binding ErrorMessage}"
                       Margin="{DynamicResource GapBlockTop}"
                       HorizontalAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <ComboBox Style="{DynamicResource ComboBoxStyle}"
                      ItemContainerStyle="{DynamicResource ComboBoxItemStyle}"
                      SelectedIndex="{Binding SelectedLanguageIndex}"
                      Margin="{DynamicResource GapBlockTop}"
                      HorizontalAlignment="Center"
                      MinWidth="130">
                <ComboBoxItem Content="English" Tag="en"/>
                <ComboBoxItem Content="Русский" Tag="ru"/>
                <ComboBoxItem Content="中文" Tag="zh"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</local:TalknadoWindow>