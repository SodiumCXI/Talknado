<UserControl x:Class="Talknado.Client.Views.Controls.UserListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Users}"
                  AlternationCount="2"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0,2,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ItemBorder"
                            Margin="0,2" 
                            Height="30"
                            CornerRadius="8"
                            Background="{DynamicResource UserItemBrush}">
                        <Grid x:Name="ItemGrid"
                              MouseLeave="ItemGrid_MouseLeave"
                              Tag="{Binding ElementName=VolumeSliderContainer}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                   Style="{DynamicResource PrimaryTextStyle}"
                                   MaxWidth="165"
                                   TextWrapping="NoWrap"
                                   FontWeight="Bold"
                                   Text="{Binding Username}"
                                   VerticalAlignment="Center"
                                   Margin="11,0,9,0"/>
                            <svgc:SvgViewbox Grid.Column="1" Width="24" VerticalAlignment="Center">
                                <svgc:SvgViewbox.Style>
                                    <Style TargetType="svgc:SvgViewbox">
                                        <Setter Property="Source" Value="/Resources/mic_off_white.svg"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMicrophoneActive}" Value="True">
                                                <Setter Property="Source" Value="/Resources/mic_on_white.svg"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </svgc:SvgViewbox.Style>
                            </svgc:SvgViewbox>
                            <StackPanel Grid.Column="2"/>
                            <Button Grid.Column="3"
                                    Style="{DynamicResource UserItemButton}"
                                    Click="ViewScreenShareButton_Click"
                                    Visibility="{Binding IsScreenShareActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                <svgc:SvgViewbox Source="/Resources/expand_white.svg" Width="24" VerticalAlignment="Center"/>
                            </Button>
                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="SpeakerButton"
                                        Style="{DynamicResource UserItemButton}"
                                        Click="SpeakerButton_Click"
                                        Tag="{Binding ElementName=VolumeSliderContainer}">
                                    <svgc:SvgViewbox Width="20">
                                        <svgc:SvgViewbox.Style>
                                            <Style TargetType="svgc:SvgViewbox">
                                                <Setter Property="Source" Value="/Resources/speaker_high_white.svg"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Volume}" Value="0">
                                                        <Setter Property="Source" Value="/Resources/speaker_mute_white.svg"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </svgc:SvgViewbox.Style>
                                    </svgc:SvgViewbox>
                                </Button>
                                <Border x:Name="VolumeSliderContainer" Width="Auto"
                                        Height="30" Margin="5,0" Background="Transparent"
                                        Visibility="Collapsed" Opacity="0" VerticalAlignment="Center">
                                    <Slider Style="{DynamicResource ModernSliderStyle}"
                                            Width="100"
                                            Minimum="0" Maximum="100"
                                            Value="{Binding Volume}"
                                            Margin="5,0"
                                            VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>