<UserControl x:Class="Talknado.Client.Views.Controls.MessageListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource MessageBorderStyle}">
                        <StackPanel Orientation="Vertical">
                            <Grid Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{DynamicResource SecondaryTextStyle}"
                                           Text="{Binding Username}"
                                           Margin="0,0,0,2"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Style="{DynamicResource SecondaryTextStyle}"
                                           Text="{Binding Timestamp}"
                                           Margin="0,0,0,2"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBox Style="{DynamicResource SelectableTextStyle}"
                                     Margin="-2,0,-2,4"
                                     Text="{Binding Text}"
                                     VerticalAlignment="Top"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
