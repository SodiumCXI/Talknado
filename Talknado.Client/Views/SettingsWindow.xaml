<local:TalknadoWindow x:Class="Talknado.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Talknado.Client.Properties.Localization"
        xmlns:local="clr-namespace:Talknado.Client.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource SettingsWindowStyle}" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome 
        CaptionHeight="0" 
        ResizeBorderThickness="6"
        CornerRadius="0"
        GlassFrameThickness="0"
        UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="BorderAround" Style="{StaticResource BorderAround}">
        <Grid Background="{DynamicResource RightPanelBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  x:Name="TitleBar"
                  Background="{DynamicResource TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="Настройки"
                           FontFamily="{StaticResource TitleBarFont}"
                           FontSize="{StaticResource SecondaryFontSize}"
                           FontWeight="DemiBold"
                           Foreground="{DynamicResource TitleBarTextBrush}"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
                           Margin="12,0,0,0"/>
                <Button Grid.Column="1"
                        x:Name="CloseButton"
                        Style="{DynamicResource CloseButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="20">
                <StackPanel>
                    <TextBlock Text="{x:Static l:Strings.InputDevicesLabel}"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding SettingManager.OutputDevices}"
                              SelectedItem="{Binding SettingManager.SelectedOutputDevice}"
                              Style="{StaticResource ComboStyle}"
                              ItemContainerStyle="{StaticResource ComboItemStyle}"/>

                    <TextBlock Text="{x:Static l:Strings.OutputDevicesLabel}"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding SettingManager.InputDevices}" 
                              SelectedItem="{Binding SettingManager.SelectedInputDevice}"
                              Style="{StaticResource ComboStyle}"
                              ItemContainerStyle="{StaticResource ComboItemStyle}"/>

                    <CheckBox Content="{x:Static l:Strings.ShareScreenWithAudioText}"
                              IsChecked="{Binding SettingManager.ScreenShareWithAudio}"
                              Style="{StaticResource SettingsCheckBoxStyle}"/>

                    <CheckBox Content="{x:Static l:Strings.AutoOpenScreenShareWindowText}"
                              IsChecked="{Binding SettingManager.AutoOpenScreenShareWindow}"
                              Style="{StaticResource SettingsCheckBoxStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</local:TalknadoWindow>
